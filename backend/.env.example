# Runtime
PORT=4000
NODE_ENV=development

# Render PostgreSQL / local PostgreSQL
DATABASE_URL=""

# Legacy login compatibility (can be removed after Firebase migration)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL=8h

# Exact allowed frontend origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Firebase Admin SDK - NEVER expose these in frontend/Vercel
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Optional Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_JSON=

# One-time seed values. Do NOT use default values in production.
SEED_SUPER_ADMIN_EMAIL=superadmin@crm.local
SEED_SUPER_ADMIN_PASSWORD=change-this-before-seeding
SEED_ADMIN_PASSWORD=change-this-before-seeding
